# hw definition file for processing by chibios_hwdef.py
# bootloader for HUMMINGBIRD_FC305_H7

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_NewBeeDrone_HUMMINGBIRD_FC305_H7

# crystal frequency
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

USB_STRING_MANUFACTURER "NewBeeDrone"
USB_STRING_PRODUCT "HUMMINGBIRD_FC305_H7-BL"

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
# must match FLASH_RESERVE_START_KB in hwdef.dat
FLASH_BOOTLOADER_LOAD_KB 128

# USB only in bootloader
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LED
PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

# Buzzer (inverted - active LOW)
PA15 BUZZER OUTPUT HIGH PUSHPULL

# Chip select pins
PA4  IMU_CS     CS
PE11 MAX7456_CS CS

PC15 PINIO1 OUTPUT HIGH PUSHPULL
PC14 PINIO2 OUTPUT HIGH PUSHPULL
PC13 PINIO3 OUTPUT HIGH PUSHPULL
